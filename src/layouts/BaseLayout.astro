---
import PostHog from "../components/posthog.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import "../index.css";

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: unknown;
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
}

const { title, description, ogType = "profile", publishedTime, modifiedTime, preloadImage, preloadSrcset, preloadSizes } = Astro.props;
const siteURL = Astro.site ? new URL(Astro.site) : new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const profileImageURL = new URL("/face.webp", siteURL);
const ogImageURL = Astro.props.ogImage
  ? new URL(Astro.props.ogImage, siteURL)
  : profileImageURL;
const personID = new URL("/#hassan-aguezoum", siteURL);
const websiteID = new URL("/#website", siteURL);

const structuredData = Astro.props.jsonLd ?? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonicalURL.href}#profile-page`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: "en",
      dateCreated: "2025-11-17",
      dateModified: "2026-08-21",
      mainEntity: { "@id": personID.href },
      isPartOf: { "@id": websiteID.href },
    },
    {
      "@type": "Person",
      "@id": personID.href,
      name: "Hassan Aguezoum",
      alternateName: "haguezoum",
      url: canonicalURL.href,
      image: profileImageURL.href,
      description:
        "Frontend engineer and 1337 Coding School student in Morocco building SaaS dashboards and API-driven products.",
      jobTitle: "Frontend Engineer",
      homeLocation: {
        "@type": "Country",
        name: "Morocco",
      },
      affiliation: [
        {
          "@type": "EducationalOrganization",
          name: "1337 Coding School",
          sameAs: "https://1337.ma/en/",
        },
        {
          "@type": "EducationalOrganization",
          name: "42 Network",
          sameAs: "https://42.fr/en/network-42/",
        },
      ],
      knowsAbout: [
        "Frontend engineering",
        "React",
        "Next.js",
        "TypeScript",
        "SaaS dashboards",
        "REST API integration",
      ],
      sameAs: [
        "https://github.com/haguezoum",
        "https://linkedin.com/in/hassan-aguezoum",
        "https://x.com/hassan_aguezoum",
        "https://dev.to/haguezoum",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteID.href,
      url: siteURL.href,
      name: "Hassan Aguezoum",
      description,
      inLanguage: "en",
      publisher: { "@id": personID.href },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Hassan Aguezoum" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    <link rel="icon" type="image/png" href="/favicon.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadSrcset ? undefined : preloadImage}
        imagesrcset={preloadSrcset}
        imagesizes={preloadSrcset ? (preloadSizes ?? "100vw") : undefined}
        fetchpriority="high"
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Non-blocking font load: preload + print-media swap keeps FCP off the
        critical path. Only the weights actually used (light→bold). */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Hassan Aguezoum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="680" />
    <meta property="og:image:height" content="680" />
    <meta property="og:image:alt" content="Portrait of Hassan Aguezoum, frontend engineer and 1337 student" />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="profile:first_name" content="Hassan" />
    <meta property="profile:last_name" content="Aguezoum" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@hassan_aguezoum" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Portrait of Hassan Aguezoum, frontend engineer and 1337 student" />

    <title>{title}</title>
    <PostHog />
    <GoogleAnalytics />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    {/* Vercel Analytics + Speed Insights are queued now and injected on idle,
        so their JS never competes with LCP/FCP bandwidth or main-thread parse. */}
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
      (function () {
        var load = function () {
          if (document.querySelector('script[data-vercel-deferred="insights"]')) return;
          var a = document.createElement("script");
          a.src = "/_vercel/insights/script.js";
          a.defer = true;
          a.dataset.vercelDeferred = "insights";
          a.onerror = function () {};
          document.head.appendChild(a);
          var s = document.createElement("script");
          s.src = "/_vercel/speed-insights/script.js";
          s.defer = true;
          s.dataset.vercelDeferred = "speed-insights";
          s.onerror = function () {};
          document.head.appendChild(s);
        };
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(load, { timeout: 4000 });
        } else {
          window.addEventListener("load", function () { setTimeout(load, 2500); }, { once: true });
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
