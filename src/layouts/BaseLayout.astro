---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../index.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteURL = Astro.site ? new URL(Astro.site) : new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const profileImageURL = new URL("/face.webp", siteURL);
const personID = new URL("/#hassan-aguezoum", siteURL);
const websiteID = new URL("/#website", siteURL);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonicalURL.href}#profile-page`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: "en",
      dateCreated: "2025-11-17",
      dateModified: "2026-08-21",
      mainEntity: { "@id": personID.href },
      isPartOf: { "@id": websiteID.href },
    },
    {
      "@type": "Person",
      "@id": personID.href,
      name: "Hassan Aguezoum",
      alternateName: "haguezoum",
      url: canonicalURL.href,
      image: profileImageURL.href,
      description:
        "Frontend engineer and 1337 Coding School student in Morocco building SaaS dashboards and API-driven products.",
      jobTitle: "Frontend Engineer",
      homeLocation: {
        "@type": "Country",
        name: "Morocco",
      },
      affiliation: [
        {
          "@type": "EducationalOrganization",
          name: "1337 Coding School",
          sameAs: "https://1337.ma/en/",
        },
        {
          "@type": "EducationalOrganization",
          name: "42 Network",
          sameAs: "https://42.fr/en/network-42/",
        },
      ],
      knowsAbout: [
        "Frontend engineering",
        "React",
        "Next.js",
        "TypeScript",
        "SaaS dashboards",
        "REST API integration",
      ],
      sameAs: [
        "https://github.com/haguezoum",
        "https://linkedin.com/in/hassan-aguezoum",
        "https://x.com/hassan_aguezoum",
        "https://dev.to/haguezoum",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteID.href,
      url: siteURL.href,
      name: "Hassan Aguezoum",
      description,
      inLanguage: "en",
      publisher: { "@id": personID.href },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Hassan Aguezoum" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    <link rel="icon" type="image/png" href="/favicon.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
    />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Hassan Aguezoum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={profileImageURL} />
    <meta property="og:image:secure_url" content={profileImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="680" />
    <meta property="og:image:height" content="680" />
    <meta property="og:image:alt" content="Portrait of Hassan Aguezoum, frontend engineer and 1337 student" />
    <meta property="profile:first_name" content="Hassan" />
    <meta property="profile:last_name" content="Aguezoum" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@hassan_aguezoum" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileImageURL} />
    <meta name="twitter:image:alt" content="Portrait of Hassan Aguezoum, frontend engineer and 1337 student" />

    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <slot />
  </body>
</html>
