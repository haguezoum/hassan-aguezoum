---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogPosts } from "../../lib/github.ts";

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog | Hassan Aguezoum"
  description="Notes on frontend engineering, Astro, and API-driven products by Hassan Aguezoum. Written as GitHub Issues, published as static pages."
>
  <main class="relative z-10 text-white antialiased max-w-3xl mx-auto px-6 sm:px-4 py-16 sm:py-24">
    <a href="/" class="text-xs uppercase tracking-widest text-white/60 hover:text-white transition-colors">← Back to portfolio</a>
    <h1 class="mt-6 text-3xl sm:text-4xl font-bold tracking-tight uppercase">Blog</h1>
    <p class="mt-4 text-white/60 font-light leading-relaxed">
      Written as GitHub Issues, published as static HTML. No database, no CMS — Astro builds every page.
    </p>

    <div class="mt-12 divide-y divide-white/10">
      {posts.map((post) => (
        <article class="py-8 first:pt-0">
          <a href={`/blog/${post.slug}`} class="group block">
            <p class="text-xs text-white/40 uppercase tracking-widest">
              <time datetime={post.createdAt}>
                {new Date(post.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </p>
            <h2 class="mt-2 text-xl sm:text-2xl font-bold tracking-tight group-hover:underline underline-offset-4">
              {post.title}
            </h2>
            <p class="mt-2 text-sm sm:text-base text-white/60 font-light leading-relaxed">{post.description}</p>
            <span class="mt-3 inline-block text-xs uppercase tracking-widest text-white/60 group-hover:text-white transition-colors">
              Read article →
            </span>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
