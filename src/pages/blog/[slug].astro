---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import { Image } from "astro:assets";
import faceCover from "../../assets/face.webp";
import { getBlogPosts } from "../../lib/github.ts";
import { localizeImage } from "../../lib/images.ts";
import { estimateReadingMinutes, renderMarkdown } from "../../lib/markdown.ts";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const html = await renderMarkdown(post.body, post.slug);
const readingMinutes = estimateReadingMinutes(post.body);

const siteURL = Astro.site ? new URL(Astro.site) : new URL(Astro.url.origin);
const canonicalURL = new URL(`/blog/${post.slug}`, siteURL);
// Known local cover → optimized imported asset. Remote uploads (GitHub
// user-attachments redirect to 5-minute signed S3 URLs, unusable for hotlink
// or OG) are downloaded at build time and self-hosted under /blog/ —
// including the og:image, so link previews never depend on expiring links.
const isRemoteCover = post.cover?.startsWith("http") ?? false;
const localCover = post.cover === "/face.webp" ? faceCover : null;
const localizedCover =
  post.cover && !localCover && isRemoteCover ? await localizeImage(post.cover, post.slug) : null;
if (isRemoteCover && !localizedCover) {
  throw new Error(`[blog] Cannot publish cover for Issue #${post.issueNumber}. Check the attachment URL and GITHUB_BLOG_TOKEN access.`);
}
if (localizedCover) console.log(`[blog] cover self-hosted for ${post.slug}`);
const ogImage = localizedCover?.src ?? post.cover ?? "/face.webp";
const coverAlt = `Cover for ${post.title}`;
const coverClass = "mt-8 w-full rounded-none border border-white/10 object-cover";
const coverSizes = "(max-width: 640px) 100vw, (max-width: 1024px) 768px, 896px";
// LCP cover: preload srcset so the browser discovers it in <head>.
const preloadSrcset = localizedCover?.srcset;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  image: new URL(ogImage, siteURL).href,
  url: canonicalURL.href,
  datePublished: post.createdAt,
  dateModified: post.updatedAt,
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: "Hassan Aguezoum",
    url: siteURL.href,
  },
  publisher: {
    "@type": "Person",
    name: "Hassan Aguezoum",
    url: siteURL.href,
  },
  mainEntityOfPage: canonicalURL.href,
};

const encodedURL = encodeURIComponent(canonicalURL.href);
const encodedTitle = encodeURIComponent(post.title);
const shareLinks = {
  x: `https://twitter.com/intent/tweet?url=${encodedURL}&text=${encodedTitle}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedURL}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedURL}`,
};
---

<BaseLayout
  title={`${post.title} | Hassan Aguezoum`}
  description={post.description}
  ogType="article"
  ogImage={ogImage}
  publishedTime={post.createdAt}
  modifiedTime={post.updatedAt}
  jsonLd={jsonLd}
  preloadImage={localizedCover?.src}
  preloadSrcset={preloadSrcset}
  preloadSizes={coverSizes}
>
  <ReadingProgress />
  <main class="relative z-10 text-white antialiased max-w-4xl mx-auto px-6 sm:px-4 py-16 sm:py-24">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: post.title }]} />

    <header class="mt-6">
      <p class="text-xs text-white/40 uppercase tracking-widest">
        <time datetime={post.createdAt}>
          {new Date(post.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <span aria-hidden="true"> · </span>
        <span>{readingMinutes} min read</span>
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-balance">{post.title}</h1>
      <p class="mt-4 text-white/60 font-light leading-relaxed">{post.description}</p>
      <div class="mt-5 flex items-center gap-2" aria-label="Share this article">
        <span class="text-[11px] uppercase tracking-widest text-white/40">Share</span>
        <a
          href={shareLinks.x}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X"
          data-posthog-share="x"
          class="inline-flex h-8 w-8 items-center justify-center border border-white/10 text-white/60 transition-colors hover:border-white/40 hover:text-white"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3.5 h-3.5 fill-current"><path d="M18.24 2.25h3.68l-8.04 9.19 9.46 12.31h-7.4l-5.8-7.58-6.63 7.58H-.17l8.58-9.8L-.66 2.25h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.33h2.04L5.82 4.31H3.63l13.32 17.27Z" /></svg>
        </a>
        <a
          href={shareLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn"
          data-posthog-share="linkedin"
          class="inline-flex h-8 w-8 items-center justify-center border border-white/10 text-white/60 transition-colors hover:border-white/40 hover:text-white"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3.5 h-3.5 fill-current"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47Z" /></svg>
        </a>
        <a
          href={shareLinks.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
          data-posthog-share="facebook"
          class="inline-flex h-8 w-8 items-center justify-center border border-white/10 text-white/60 transition-colors hover:border-white/40 hover:text-white"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3.5 h-3.5 fill-current"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07Z" /></svg>
        </a>
        <button
          type="button"
          data-share-copy={canonicalURL.href}
          aria-label="Copy article link"
          class="inline-flex h-8 items-center gap-1.5 border border-white/10 px-2.5 text-[11px] uppercase tracking-widest text-white/60 transition-colors hover:border-white/40 hover:text-white"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="w-3.5 h-3.5 fill-current"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z" /></svg>
          <span data-share-copy-label>Copy link</span>
        </button>
      </div>
      {post.cover && localCover && (
        <Image
          src={localCover}
          widths={[640, 960, 1280]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 768px, 960px"
          alt={`Cover for ${post.title}`}
          width={960}
          height={960}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mt-8 w-full rounded-none border border-white/10 object-cover"
        />
      )}
      {localizedCover && (
        <img src={localizedCover.src} srcset={localizedCover.srcset} sizes={coverSizes}
          width={localizedCover.width} height={localizedCover.height}
          fetchpriority="high" loading="eager" decoding="async" alt={coverAlt} class={coverClass} />
      )}
      {post.cover && !localCover && !isRemoteCover && (
        <img
          src={post.cover}
          alt={`Cover for ${post.title}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mt-8 w-full rounded-none border border-white/10 object-cover"
        />
      )}
    </header>

    <article class="blog-content mt-10" set:html={html} />

    <footer class="mt-12 border-t border-white/10 pt-6 text-sm text-white/40">
      <p>
        Discuss or suggest edits on the source{" "}
        <a href={post.issueUrl} target="_blank" rel="noopener noreferrer" class="text-white/70 underline underline-offset-4 hover:text-white">
          GitHub Issue #{post.issueNumber}
        </a>.
      </p>
    </footer>
  </main>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-share-copy]");
  copyButton?.addEventListener("click", async () => {
    const url = copyButton.dataset.shareCopy ?? window.location.href;
    const label = copyButton.querySelector<HTMLElement>("[data-share-copy-label]");
    const restore = () => {
      window.setTimeout(() => {
        if (label) label.textContent = "Copy link";
      }, 2000);
    };
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = "Copied ✓";
      window.posthog?.capture("blog_link_copied");
    } catch {
      const fallback = document.createElement("textarea");
      fallback.value = url;
      document.body.appendChild(fallback);
      fallback.select();
      document.execCommand("copy");
      fallback.remove();
      if (label) label.textContent = "Copied ✓";
    }
    restore();
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-posthog-share]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("blog_shared", { platform: link.dataset.posthogShare });
    });
  });
</script>

<style is:global>
  /* Global: this stylesheet targets Markdown HTML injected at runtime via
     set:html, which never receives Astro's scoped data attributes. All
     selectors are prefixed with .blog-content to stay contained. */
  .blog-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: rgb(255 255 255 / 75%);
    font-weight: 300;
    line-height: 1.75;
    min-width: 0;
  }
  /* Flex items default to min-width:auto, which lets wide <pre> blocks push
     the whole page wider instead of scrolling internally. */
  .blog-content > * {
    min-width: 0;
    max-width: 100%;
  }
  .blog-content h2 {
    color: #fff;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin-top: 2rem;
  }
  .blog-content p { font-size: 1rem; }
  .blog-content a { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .blog-content ul { list-style: disc; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .blog-content pre {
    border: 1px solid rgb(255 255 255 / 10%);
    background: #0d1117;
    padding: 1rem;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .blog-content pre code { background: transparent; padding: 0; }
  .blog-content :not(pre) > code {
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 10%);
    padding: 0.125rem 0.375rem;
    font-size: 0.8125rem;
    color: #fff;
  }
  .blog-content img {
    width: 100%;
    height: auto;
    border: 1px solid rgb(255 255 255 / 10%);
  }
  .blog-content blockquote {
    border-left: 2px solid rgb(255 255 255 / 25%);
    padding-left: 1rem;
    color: rgb(255 255 255 / 60%);
  }
</style>
