---
import BaseLayout from "../layouts/BaseLayout.astro";
import WebGLBackground from "../components/WebGLBackground.tsx";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Hassan Aguezoum | Frontend Engineer & 1337 Student"
  description="Hassan Aguezoum is a frontend engineer and 1337 Coding School student in Morocco, building SaaS dashboards and API-driven products with React and Next.js."
>
  <WebGLBackground client:idle={{ timeout: 2000 }} />

  <img
    src="/face-56.webp"
    srcset="/face-40.webp 40w, /face-56.webp 56w, /face-80.webp 80w, /face-112.webp 112w"
    sizes="(min-width: 1024px) 56px, (min-width: 640px) 44px, 40px"
    alt="Portrait of Hassan Aguezoum, frontend engineer and 1337 student"
    width="56"
    height="56"
    decoding="async"
    class="fixed bottom-4 right-4 z-50 w-10 h-10 sm:w-11 sm:h-11 lg:w-14 lg:h-14 rounded-full object-cover"
  />

  <div aria-hidden="true" class="fixed inset-0 z-0 pointer-events-none bg-gradient-overlay"></div>

  <main class="relative z-10 text-white antialiased flex flex-col gap-24 px-6 sm:px-4 lg:px-8 max-w-7xl mx-auto lg:flex-row lg:gap-0 selection:bg-white selection:text-black">
    <Hero />

    <div class="lg:w-[55%] min-w-0">
      <div id="about" data-section-index="0" class="mb-16 sm:mb-18 lg:mb-20">
        <About />
      </div>
      <div id="projects" data-section-index="1" class="mb-16 sm:mb-18 lg:mb-20">
        <Projects />
      </div>
      <div id="checkpoints" data-section-index="2" class="mb-16 sm:mb-18 lg:mb-20">
        <Experience />
      </div>
      <Footer />
    </div>
  </main>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section-index]"));
  const navButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-nav-index]"));

  function setActiveSection(index: number) {
    navButtons.forEach((button, buttonIndex) => {
      if (buttonIndex === index) button.setAttribute("aria-current", "location");
      else button.removeAttribute("aria-current");
    });
  }

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      const activeEntry = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!activeEntry) return;
      const index = sections.indexOf(activeEntry.target as HTMLElement);
      if (index >= 0) setActiveSection(index);
    },
    { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
  );
  sections.forEach((section) => sectionObserver.observe(section));

  navButtons.forEach((button, index) => {
    button.addEventListener("click", () => {
      const target = sections[index];
      if (!target) return;
      target.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "start",
      });
    });
  });

  const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ⵇⵡⴻⵔⵜⵢⵓⵉoⴰⵙⴷⴼⴳⵀⵊⴽⵍⵎⵏⴱⵯⵛⵅⵣⵃⵅⵛⵚⵕⵥ";
  document.querySelectorAll<HTMLElement>("[data-nav-label]").forEach((label) => {
    const original = label.dataset.value ?? label.innerText;
    let interval = 0;

    const stop = () => {
      window.clearInterval(interval);
      interval = 0;
    };

    label.parentElement?.addEventListener("mouseenter", () => {
      if (reduceMotion) return;
      stop();
      let progress = 0;
      interval = window.setInterval(() => {
        label.innerText = original
          .split("")
          .map((character, characterIndex) =>
            characterIndex < progress
              ? original[characterIndex]
              : character === " "
                ? " "
                : letters[Math.floor(Math.random() * letters.length)],
          )
          .join("");
        progress += 1 / 3;
        if (progress >= original.length) {
          stop();
          label.innerText = original;
        }
      }, 40);
    });

    label.parentElement?.addEventListener("mouseleave", () => {
      stop();
      label.innerText = original;
    });
  });

  if (!reduceMotion) {
    const revealRows = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal-row]"));
    revealRows.forEach((row) => {
      row.style.opacity = "0";
      row.style.transform = "translateX(-15px)";
    });

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const row = entry.target as HTMLElement;
          row.animate(
            [
              { opacity: 0, transform: "translateX(-15px)" },
              { opacity: 1, transform: "translateX(0)" },
            ],
            { duration: 300, easing: "ease-out", fill: "forwards" },
          );
          observer.unobserve(row);
        });
      },
      { rootMargin: "0px 0px -8%", threshold: 0.05 },
    );
    revealRows.forEach((row) => revealObserver.observe(row));
  }

  const phrases = ["build", "design", "ship", "think", "feel"];
  const typeText = document.querySelector<HTMLElement>("[data-type-text]");
  if (typeText) {
    if (reduceMotion) {
      typeText.textContent = phrases[0];
    } else {
      let phraseIndex = 0;
      let characterIndex = 0;
      let deleting = false;

      const type = () => {
        const phrase = phrases[phraseIndex];
        characterIndex += deleting ? -1 : 1;
        typeText.textContent = phrase.slice(0, characterIndex);

        if (!deleting && characterIndex === phrase.length) {
          deleting = true;
          window.setTimeout(type, 1200);
          return;
        }
        if (deleting && characterIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
        }
        window.setTimeout(type, deleting ? 40 : 80);
      };
      type();
    }
  }

  const quotes = [
    '"Developers work hard to earn money and they give their work for free at the same time."',
    '"Remember kids, modern problems require modern solutions."',
    '"facebook is down, thanks god not our app #facebook_is_down"',
  ];
  const quote = document.querySelector<HTMLElement>("[data-footer-quote]");
  const quoteText = document.querySelector<HTMLElement>("[data-quote-text]");
  const xLogo = document.querySelector<HTMLElement>("[data-x-logo]");
  let quoteIndex = Math.floor(Math.random() * quotes.length);
  let quoteHovered = false;
  if (quoteText) quoteText.textContent = quotes[quoteIndex];

  window.setInterval(() => {
    if (!quote || !quoteText || quoteHovered) return;
    quote.classList.add("opacity-0");
    window.setTimeout(() => {
      let next = quoteIndex;
      while (next === quoteIndex) next = Math.floor(Math.random() * quotes.length);
      quoteIndex = next;
      quoteText.textContent = quotes[quoteIndex];
      quote.classList.remove("opacity-0");
    }, reduceMotion ? 0 : 280);
  }, 5000);

  quote?.addEventListener("pointerenter", () => {
    quoteHovered = true;
    if (!xLogo) return;
    xLogo.getAnimations().forEach((animation) => animation.cancel());
    xLogo.style.visibility = "visible";
    xLogo.animate(
      reduceMotion
        ? [
            { opacity: 0 },
            { opacity: 1, offset: 0.2 },
            { opacity: 1, offset: 0.8 },
            { opacity: 0 },
          ]
        : [
            { opacity: 0, transform: "translateX(0) rotate(0deg) scale(.85)" },
            { opacity: 1, transform: "translateX(0) rotate(0deg) scale(1)", offset: 0.15 },
            { opacity: 1, transform: "translateX(10px) rotate(30deg)", offset: 0.32 },
            { opacity: 1, transform: "translateX(-10px) rotate(-30deg)", offset: 0.5 },
            { opacity: 1, transform: "translateX(10px) rotate(30deg)", offset: 0.68 },
            { opacity: 1, transform: "translateX(-10px) rotate(-30deg)", offset: 0.86 },
            { opacity: 0, transform: "translateX(0) rotate(0deg)" },
          ],
      {
        duration: reduceMotion ? 1400 : 2350,
        easing: "ease-in-out",
        fill: "forwards",
      },
    );
  });
  quote?.addEventListener("pointerleave", () => {
    quoteHovered = false;
  });
</script>
