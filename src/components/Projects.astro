---
import { projects } from "./projects.json";

const externalIcon = `M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3Zm5 16H5V5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6Z`;
---

<h2 class="text-xl uppercase font-bold px-4 sm:px-6 lg:px-8 mb-10 sm:mb-12 lg:hidden">Projects</h2>
<div class="space-y-0 divide-y divide-white/20" data-project-list>
  {projects.map((project, index) => {
    const number = String(index + 1).padStart(2, "0");
    const primaryHref = project.repo || project.url;
    const subtitle = project.repo
      ? project.repo.replace("https://github.com/", "")
      : project.url
        ? new URL(project.url).host
        : "";

    return (
      <article
        id={`editorial-project-${project.id}`}
        data-project
        data-reveal-row
        class="group py-6 sm:py-7 lg:py-8 px-4 sm:px-6 lg:px-8 hover:bg-neutral-900/10 transition-all duration-300"
      >
        <div class="flex flex-col gap-4">
          <span class="text-xs text-neutral-500 font-bold tracking-widest">PROJECT {number}</span>

          <div>
            {primaryHref ? (
              <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 group/title">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="text-white/60 group-hover:text-white transition-colors duration-200 w-6 h-6 sm:w-7 sm:h-7 fill-current"><path d={externalIcon} /></svg>
                <h3 class="font-bold text-xl sm:text-2xl text-white tracking-tighter uppercase leading-none">{project.name}</h3>
              </a>
            ) : (
              <h3 class="font-bold text-xl sm:text-2xl text-white tracking-tighter uppercase leading-none">{project.name}</h3>
            )}
            {subtitle && <p class="text-xs text-neutral-400 mt-1.5 uppercase tracking-wide">{subtitle}</p>}
          </div>

          <p class="font-light text-sm sm:text-base text-white/60 leading-relaxed tracking-tight group-hover:text-white transition-colors duration-300">
            {project.description}
          </p>

          {project.url && (
            <div class="text-[11px] text-neutral-500">
              <div class="flex items-center gap-1">
                DEPLOY:
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-neutral-300 underline font-semibold flex items-center gap-0.5 hover:text-white">
                  ONLINE INSTANCE
                </a>
              </div>
            </div>
          )}

          <div class="flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <span class="px-2.5 py-0.5 border border-white/10 bg-black text-[10px] text-neutral-400 capitalize tracking-wide hover:border-white hover:text-white transition-colors rounded-none">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </article>
    );
  })}
</div>
