---
const sections = ["About", "Projects", "Checkpoints"];
---

<header class="w-full lg:sticky lg:top-0 lg:self-start lg:w-[45%] lg:shrink-0 lg:min-h-screen py-10 sm:py-12 lg:py-16 lg:flex lg:flex-col lg:justify-between">
  <div class="max-w-xl lg:max-w-none">
    <div class="flex items-center gap-2 mb-2" aria-label="I build, design, ship, think, and feel">
      <span class="text-sm font-mono text-white/60 tracking-widest uppercase" data-type-badge>
        <span data-type-text>build</span><span class="type-cursor" aria-hidden="true">|</span>
      </span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-2 leading-none">Hassan Aguezoum</h1>
    <div class="mb-4 text-base sm:text-lg lg:text-xl font-medium flex flex-wrap gap-x-2 gap-y-1">
      <span>Frontend Engineer</span>
      <span class="mx-2 text-white/60" aria-hidden="true">/</span>
      <span>1337 Student · 42 Network</span>
    </div>
    <p class="text-sm sm:text-base lg:text-md font-light text-white/60 max-w-sm sm:max-w-md mb-10 lg:mb-16 leading-relaxed">
      React, Next.js, and TypeScript for SaaS dashboards and API-driven products. Responsive, typed, ready to ship.
    </p>

    <nav class="hidden lg:flex flex-col gap-2" aria-label="Portfolio sections">
      {sections.map((label, index) => (
        <button
          type="button"
          data-nav-index={index}
          aria-current={index === 0 ? "location" : undefined}
          class="portfolio-nav bg-linear-to-r from-black/50 to-transparent flex items-center gap-1 px-4 py-2 cursor-pointer text-left w-full transition-all duration-300 border-0 outline-none focus-visible:ring-1 focus-visible:ring-white/40 focus-visible:ring-offset-0"
        >
          <span data-nav-number class="font-mono tracking-widest">0{index + 1}.</span>
          <span data-nav-label data-value={label} class="font-light tracking-tight uppercase">{label}</span>
        </button>
      ))}
    </nav>
  </div>

  <div class="mt-10 lg:mt-0">
    <div class="flex items-center gap-6 pl-2">
      <a href="https://github.com/haguezoum" target="_blank" rel="noopener noreferrer me" aria-label="Hassan Aguezoum on GitHub" class="text-white-600 hover:text-white transition">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="w-7 h-7 fill-current"><path d="M12 .7A11.5 11.5 0 0 0 8.36 23c.58.1.79-.25.79-.56v-2.22c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.73.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.58-.3-5.29-1.29-5.29-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05a4.46 4.46 0 0 1 1.19 3.09c0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.21c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
      </a>
      <a href="https://linkedin.com/in/hassan-aguezoum" target="_blank" rel="noopener noreferrer me" aria-label="Hassan Aguezoum on LinkedIn" class="text-white-600 hover:text-white transition">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="w-7 h-7 fill-current"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47Z" /></svg>
      </a>
      <a href="mailto:hassanaguezoum@gmail.com" aria-label="Email" class="text-white-600 hover:text-white transition">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="w-7 h-7 fill-current"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" /></svg>
      </a>
    </div>
  </div>
</header>
