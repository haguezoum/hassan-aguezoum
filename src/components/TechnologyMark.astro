---
import type { Technology } from "../lib/tech-stack";
interface Props { technology: Technology; }
const { technology } = Astro.props;
---

{technology.src ? (
  <img src={technology.src} width="32" height="32" alt="" draggable="false" />
) : (
  <span class="technology-text-mark">{technology.mark}</span>
)}

<style>
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .technology-text-mark {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: #d9f99d;
    font: 600 9px/1 monospace;
    letter-spacing: -.03em;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 5px;
    background: #10110d;
  }
</style>
