---
import { checkpoints } from "./checkpoints.json";

const externalIcon = `M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3Zm5 16H5V5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6Z`;
---

<h2 id="checkpoints-heading" class="text-xl uppercase font-bold px-4 sm:px-6 lg:px-8 mb-10 sm:mb-12 lg:sr-only">Experience and 1337 education</h2>
<div class="space-y-0">
  {checkpoints.map((checkpoint) => (
    <article
      id={`checkpoint-${checkpoint.id}`}
      data-reveal-row
      class="group py-6 sm:py-7 lg:py-8 px-4 sm:px-6 lg:px-8 hover:bg-neutral-900/10 transition-all duration-300"
    >
      <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <span class="text-xs text-white/60 font-bold tracking-widest">{checkpoint.type.toUpperCase()}</span>
            <h3 class="font-bold text-xl sm:text-2xl text-white tracking-tighter uppercase leading-none mt-2">{checkpoint.title}</h3>
            <p class="text-xs text-neutral-400 mt-1.5 uppercase tracking-wide">{checkpoint.organization}</p>
          </div>
          <span class="text-xs text-white/60 font-bold tracking-widest uppercase">{checkpoint.dateRange}</span>
        </div>

        <p class="font-light text-sm sm:text-base text-white/60 leading-relaxed tracking-tight group-hover:text-white transition-colors duration-300">
          {checkpoint.summary}
        </p>

        {checkpoint.details.length > 0 && (
          <ul class="space-y-2 text-sm text-white/55 leading-relaxed list-disc pl-5">
            {checkpoint.details.map((detail) => <li>{detail}</li>)}
          </ul>
        )}

        {checkpoint.techSkills.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {checkpoint.techSkills.map((skill) => (
              <span class="px-2.5 py-0.5 border border-white/10 bg-black text-[10px] text-neutral-400 capitalize tracking-wide hover:border-white hover:text-white transition-colors rounded-none">
                {skill}
              </span>
            ))}
          </div>
        )}

        {checkpoint.link && (
          <a href={checkpoint.link} target="_blank" rel="noopener noreferrer" data-posthog-credential data-credential-type={checkpoint.type} class="inline-flex items-center gap-1.5 text-sm text-white/60 hover:text-white transition-colors duration-200">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-5 h-5 fill-current"><path d={externalIcon} /></svg>
            <span>OPEN LINK</span>
          </a>
        )}
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-posthog-credential]").forEach((link) => {
    link.addEventListener("click", () => {
      window.posthog?.capture("portfolio_credential_opened", {
        credential_type: link.dataset.credentialType,
      });
    });
  });
</script>
